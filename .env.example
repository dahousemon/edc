# Aurora EDC AI Assistant - Environment Configuration

# ======================
# Required Configuration
# ======================

# Anthropic API Key (required for Claude AI)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ======================
# Database Configuration
# ======================

# PostgreSQL connection (for local development)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aurora_edc
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/aurora_edc

# ======================
# Application Settings
# ======================

# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (enables detailed logging and API docs)
DEBUG=true

# ======================
# Vector Store
# ======================

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./data/chroma

# Embedding model for semantic search
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ======================
# Claude Configuration
# ======================

# Claude model to use
CLAUDE_MODEL=claude-sonnet-4-20250514

# Maximum tokens for responses
MAX_TOKENS=4096

# Temperature for response generation (0.0-1.0)
TEMPERATURE=0.7

# ======================
# Security
# ======================

# Secret key for JWT tokens (change in production!)
SECRET_KEY=dev-secret-key-change-in-production-abc123

# Access token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ======================
# CORS Configuration
# ======================

# Allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ======================
# Azure Configuration (Optional - for production)
# ======================

# Azure AD B2C
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Azure AI Search (alternative to ChromaDB in production)
# AZURE_SEARCH_ENDPOINT=
# AZURE_SEARCH_KEY=
